# --- Required ---------------------------------------------------------------
# Bot token for THIS machine (one Discord application per machine; all its agents share it)
DISCORD_BOT_TOKEN=
# Discord user IDs allowed to command the agents (comma-separated)
ALLOWED_USER_IDS=123456789012345678
# Who may TALK to the agents: "allowlist" (only ALLOWED_USER_IDS) or "anyone" (any member of the server).
# ALLOWED_USER_IDS are always the admins: they approve plans and tools and use slash commands.
ACCESS_MODE=allowlist
# With ACCESS_MODE=anyone, also let anyone approve plans and tools. An approver can make an agent
# run commands on your machine, so leave this false unless the server is fully trusted.
ANYONE_CAN_APPROVE=false
# Folder where repos are cloned and projects live on this machine
BASE_PROJECT_DIR=/Users/you/projects

# --- Servers ----------------------------------------------------------------
# Leave both empty to work in every Discord server the bot is invited to.
# Or restrict to specific servers (comma-separated IDs):
DISCORD_GUILD_IDS=
# Legacy single-server setting (still works, added to the list above)
DISCORD_GUILD_ID=

# --- Multi-agent ------------------------------------------------------------
# Name shown to other agents; defaults to this machine's hostname
HOST_NAME=
# (Agents find each other automatically: each announces itself in its channel.)
# Max consecutive agent-to-agent turns in a channel before a human must speak
MAX_PEER_HOPS=4

# --- Behaviour --------------------------------------------------------------
# Claude proposes a plan and waits for your approval before changing anything
PLAN_FIRST=true
# An approved plan also covers follow-up messages for this many minutes
PLAN_TTL_MIN=30
# Largest single file posted to Discord; bigger files are split into numbered parts.
# 9 is safe for servers without boosts.
UPLOAD_LIMIT_MB=9
RATE_LIMIT_PER_MINUTE=10
# Show estimated cost in results and /tracker (set false for subscription plans)
SHOW_COST=true
# Optional: pin a model (leave blank for the Claude Code default)
CLAUDE_MODEL=
