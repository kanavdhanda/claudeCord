{
  "name": "claudecord-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run --exclude \"**/*.e2e.test.ts\"",
    "typecheck": "tsc -b",
    "bench": "pnpm --filter @claudecord/hub exec tsx bench/load.ts",
    "bench:serve": "pnpm --filter @claudecord/hub exec tsx bench/serve.ts",
    "bench:k6": "k6 run packages/hub/bench/k6/agents.js",
    "test:e2e": "vitest run e2e",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "ci:local": "node scripts/ci/local.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.13.0"
}
